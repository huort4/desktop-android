# Required webtop login. Use a long, unique password outside local testing.
WEBTOP_USER=admin
WEBTOP_PASSWORD=change-this-to-a-long-random-password

# Optional runtime settings (defaults match the Dockerfile)
PUID=1000
PGID=1000
TZ=Asia/Tehran
WEBTOP_HTTPS_BIND=0.0.0.0
CPU_LIMIT=4
MEMORY_LIMIT=4G

# false = X11 (recommended; android-perf.sh targets XFCE/X11), true = Wayland
PIXELFLUX_WAYLAND=false

# --- Stream profile: keep exactly one block active ---
# Balanced (default):
MAX_RES=1280x720
SELKIES_FRAMERATE=24
SELKIES_H264_CRF=30
# Speed (weak mobile network / fastest window switching):
# MAX_RES=960x540
# SELKIES_FRAMERATE=20
# SELKIES_H264_CRF=32
# Quality (good connection):
# MAX_RES=1920x1080
# SELKIES_FRAMERATE=30
# SELKIES_H264_CRF=28

SELKIES_ENCODER=x264enc-striped
# "false|locked" hides the toggle in the UI; use "true" to enable audio.
SELKIES_AUDIO_ENABLED=false|locked
